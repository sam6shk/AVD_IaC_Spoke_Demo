# Sample Inputs for AVD 2nd Spoke Landing Zone Deployment

location = "eastus2"
prefix   = "avd-spk"
environment = "prod"

# Existing Hub Landing Zone References
hub_vnet_name           = "vnet-hub-prod-eastus2"
hub_vnet_id             = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-hub-network-prod/providers/Microsoft.Network/virtualNetworks/vnet-hub-prod-eastus2"
hub_resource_group_name = "rg-hub-network-prod"
hub_nva_firewall_ip     = "10.1.0.4"

# AVD Spoke VNet Sizing
spoke_vnet_address_space         = ["10.2.0.0/16"]
session_hosts_subnet_prefix      = ["10.2.1.0/24"]
private_endpoints_subnet_prefix = ["10.2.2.0/24"]

# AVD Host Pool & VM Settings
host_pool_type        = "Pooled"
load_balancer_type    = "BreadthFirst"
max_sessions_per_host = 10

session_host_count    = 2
vm_size               = "Standard_D4ds_v5"
local_admin_username  = "avdadmin"
local_admin_password  = "P@ssw0rd2026!AVD#Secure"

# Image Update Settings (Azure Compute Gallery)
use_custom_gallery_image = false
# custom_image_version_id = "/subscriptions/.../galleries/sigavdspkprod/images/win11-23h2-avd-golden-image/versions/1.0.1"

# Storage Quotas
fslogix_share_quota_gb   = 100
appattach_share_quota_gb = 200
